---
/** セクションの外枠。見出し・一言を同じ組み方でそろえる */
import { css, cx } from 'styled-system/css';

interface Props {
  id: string;
  title: string;
  lead?: string;
  center?: boolean;
  class?: string;
}

const { id, title, lead, center = false, class: className } = Astro.props;
const headingId = `${id}-title`;

const section = css({ paddingTop: 'clamp(88px, 11vw, 150px)' });
const inner = css({ width: 'min({sizes.container}, 100% - clamp(40px, 8vw, 80px))', marginInline: 'auto' });
const head = css({ '&[data-center]': { textAlign: 'center', '& p': { marginInline: 'auto' } } });
const h2 = css({ textStyle: 'h2' });
const leadCls = css({ marginTop: '16px', maxWidth: '40em', color: 'fg.muted', textStyle: 'lead' });
---

<section class={cx(section, className)} id={id} aria-labelledby={headingId}>
  <div class={inner}>
    <div class={head} data-center={center || undefined}>
      <h2 class={h2} id={headingId}>{title}</h2>
      {lead && <p class={leadCls}>{lead}</p>}
    </div>
    <slot />
  </div>
</section>
