---
/**
 * ほかの人のワールド。ubichill.com の公開ワールド一覧（ビルド時に取得）から新しい順に出す。
 * サムネイルが無いワールドは、入っている mod から決めた夜の部屋の絵を出す。
 */
import { css } from 'styled-system/css';
import { site } from '../../data/site';
import {
  getWorlds,
  isVerified,
  pickFeatured,
  worldArt,
  worldAuthor,
  worldHost,
  worldShareUrl,
} from '../../data/worlds';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Section from '../Section.astro';

const result = await getWorlds();
const worlds = pickFeatured(result.worlds, 6);

const grid = css({
  marginTop: '48px',
  display: 'grid',
  gridTemplateColumns: 'repeat(3, 1fr)',
  gap: '16px',
  lgDown: { gridTemplateColumns: 'repeat(2, 1fr)' },
  smDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const card = css({
  display: 'flex',
  flexDirection: 'column',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border}',
  overflow: 'hidden',
  transition: 'background {durations.fast} ease',
  _hover: { bg: 'bg.subtle' },
  '& .art': {
    position: 'relative',
    aspectRatio: '16 / 10',
    overflow: 'hidden',
    bg: 'bg.inverse',
    backgroundImage: '{gradients.lamp}',
    color: '#dfe6f5',
  },
  '& .art img': { width: '100%', height: '100%', objectFit: 'cover' },
  '& .host': {
    position: 'absolute',
    left: '12px',
    top: '12px',
    zIndex: 2,
    fontFamily: 'mono',
    fontSize: '11px',
    padding: '4px 8px',
    borderRadius: '8px',
    bg: 'rgba(10, 17, 32, .55)',
    color: '#f4efe6',
    backdropFilter: 'blur(6px)',
  },
  '& .body': {
    padding: '16px 20px',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'space-between',
    gap: '12px',
    flex: 1,
  },
  '& h3': {
    fontSize: '16px',
    fontWeight: '700',
    overflow: 'hidden',
    display: '-webkit-box',
    WebkitBoxOrient: 'vertical',
    WebkitLineClamp: 2,
  },
  '& .by': {
    display: 'block',
    marginTop: '4px',
    fontFamily: 'mono',
    fontSize: '12px',
    color: 'fg.muted',
    overflowWrap: 'anywhere',
  },
  '& .ok': { display: 'inline-flex', color: 'status.ok', flex: 'none' },
  '& .desc': {
    padding: '0 20px 20px',
    marginTop: '-4px',
    textStyle: 'small',
    color: 'fg.muted',
    overflow: 'hidden',
    display: '-webkit-box',
    WebkitBoxOrient: 'vertical',
    WebkitLineClamp: 2,
  },
});
// サムネイルが無いときの絵（夜の部屋。入っている mod で変える）
const art = css({
  '& svg': { position: 'absolute', inset: 0, width: '100%', height: '100%' },
  '& .stroke': {
    fill: 'none',
    strokeWidth: '5',
    strokeLinecap: 'round',
    strokeLinejoin: 'round',
    vectorEffect: 'non-scaling-stroke',
  },
  '& .cursor': { fill: '#f4efe6', stroke: 'rgba(0,0,0,.4)', strokeWidth: '1' },
  '& .tag': { fill: 'rgba(10,17,32,.75)' },
  '& .name': { fontFamily: 'body', fontSize: '11px', fontWeight: '700', fill: '#f4efe6' },
  '& .screen': { fill: '#05080f', stroke: 'rgba(255,255,255,.18)', strokeWidth: '1.5' },
  '& .play': { fill: 'rgba(255,255,255,.85)' },
  '& .grid': { stroke: 'rgba(255,255,255,.08)', strokeWidth: '1' },
  '& .box': { fill: 'rgba(255,255,255,.9)' },
});
const note = css({ marginTop: '20px', textAlign: 'center', textStyle: 'small', color: 'fg.subtle' });
const cta = css({ marginTop: '24px', display: 'flex', justifyContent: 'center' });
---

<Section id="explore" title="ほかの人のワールドへ" center>
  <div class={grid}>
    {
      worlds.map((w, i) => {
        const kind = worldArt(w);
        // カーソルの位置をカードごとに少しずらす（同じ絵が並ばないように）
        const shift = `translate(${(i % 3) * 26 - 26} ${(i % 2) * 16 - 8})`;
        return (
          <a class={card} href={worldShareUrl(w)} rel="noopener">
            <div class:list={['art', art]}>
              <span class="host">{worldHost(w)}</span>
              {w.thumbnail ? (
                <img src={w.thumbnail} alt="" loading="lazy" decoding="async" />
              ) : (
                <svg viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                  {kind === 'cinema' && (
                    <>
                      <rect class="screen" x="60" y="34" width="200" height="112" rx="8" />
                      <path class="play" d="M148 72 l 32 18 -32 18 z" />
                      <path class="stroke" d="M40 170 h 240" stroke="rgba(255,255,255,.15)" />
                    </>
                  )}
                  {kind === 'danmaku' && (
                    <>
                      <path class="stroke" d="M36 60 h 70" stroke="#9ab2f8" />
                      <path class="stroke" d="M150 96 h 110" stroke="#ceb0fa" />
                      <path class="stroke" d="M70 134 h 60" stroke="#bde1fb" />
                      <path class="stroke" d="M190 48 h 70" stroke="#f4b89a" />
                      <path class="stroke" d="M120 164 h 90" stroke="#f1c86c" />
                    </>
                  )}
                  {kind === 'wasm' && (
                    <>
                      {Array.from({ length: 9 }, (_, i) => (
                        <line class="grid" x1={i * 40} y1="0" x2={i * 40} y2="200" />
                      ))}
                      {Array.from({ length: 6 }, (_, i) => (
                        <line class="grid" x1="0" y1={i * 40} x2="320" y2={i * 40} />
                      ))}
                      <rect class="box" x="130" y="70" width="60" height="60" rx="14" />
                    </>
                  )}
                  {(kind === 'draw' || kind === 'room') && (
                    <>
                      <path class="stroke" d="M30 120 C 70 60, 120 170, 170 110 S 250 90, 290 70" stroke="#bde1fb" />
                      <path class="stroke" d="M90 50 c -14 -22 -40 2 -14 20 c 26 -18 0 -42 -14 -20 z" stroke="#f4b89a" transform="translate(120 10) scale(1.2)" />
                      <path class="stroke" d="M200 150 a 14 14 0 1 0 0.1 0" stroke="#ceb0fa" />
                    </>
                  )}
                  <g transform={shift}>
                    <path class="cursor" d="M70 150 l 0 22 l 5 -5 l 4 9 l 4 -2 l -4 -9 l 7 0 z" />
                    <rect class="tag" x="84" y="160" width="46" height="18" rx="9" />
                    <text class="name" x="107" y="173" text-anchor="middle">
                      haku
                    </text>
                    <path class="cursor" d="M230 90 l 0 22 l 5 -5 l 4 9 l 4 -2 l -4 -9 l 7 0 z" />
                    <rect class="tag" x="244" y="100" width="40" height="18" rx="9" />
                    <text class="name" x="264" y="113" text-anchor="middle">
                      mio
                    </text>
                  </g>
                </svg>
              )}
            </div>
            <div class="body">
              <div>
                <h3>{w.displayName}</h3>
                <span class="by">{worldAuthor(w)}</span>
              </div>
              {isVerified(w) && (
                <span class="ok" title="作者署名あり">
                  <Icon name="badge-check" size={16} />
                </span>
              )}
            </div>
            {w.description && <p class="desc">{w.description}</p>}
          </a>
        );
      })
    }
  </div>
  <p class={note}>
    ubichill.com の公開ワールドから。{result.source === 'fallback' ? '（保存してある一覧を表示）' : ''}
  </p>
  <div class={cta}>
    <Button href={site.app} icon="arrow-ur">ワールドを探す</Button>
  </div>
</Section>
