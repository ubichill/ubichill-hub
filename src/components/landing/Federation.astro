---
import { css } from 'styled-system/css';
import { exampleLinks, exampleServers } from '../../data/site';
import Icon, { type IconName } from '../Icon.astro';
import Section from '../Section.astro';

const layers: { icon: IconName; title: string; addr: [string, string]; tint: string }[] = [
  { icon: 'users', title: '人は、ホームサーバーに', addr: ['@yokan', '@yokan.example'], tint: 'sky' },
  { icon: 'home', title: '部屋は、部屋のサーバーに', addr: ['chill-room', '@yokan.example'], tint: 'periwinkle' },
  { icon: 'box', title: '作品は、作者の URL に', addr: ['mio.dev', '/mods/like/'], tint: 'lavender' },
];

const layerGrid = css({
  marginTop: '48px',
  display: 'grid',
  gridTemplateColumns: 'repeat(3, 1fr)',
  gap: '18px',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const layer = css({
  display: 'grid',
  gridTemplateColumns: '52px 1fr',
  gap: '6px 16px',
  alignItems: 'center',
  padding: '22px 24px',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'card',
  '& h3': { textStyle: 'h3', lineHeight: '1.4' },
});
const layerIcon = css({
  gridRow: 'span 2',
  width: '52px',
  height: '52px',
  borderRadius: '17px',
  display: 'grid',
  placeItems: 'center',
});
const tints: Record<string, string> = {
  sky: css({ bg: 'tint.sky' }),
  periwinkle: css({ bg: 'tint.periwinkle' }),
  lavender: css({ bg: 'tint.lavender' }),
};
const addr = css({
  justifySelf: 'start',
  fontFamily: 'mono',
  fontSize: '12px',
  padding: '4px 10px',
  borderRadius: 'sm',
  bg: 'bg.subtle',
  overflowWrap: 'anywhere',
  '& b': { color: 'highlight', fontWeight: '500' },
});
const map = css({
  position: 'relative',
  marginTop: '18px',
  height: '400px',
  borderRadius: 'lg',
  overflow: 'hidden',
  boxShadow: 'card',
  bg: 'bg.surface',
  backgroundImage:
    'linear-gradient({colors.border} 1px, transparent 1px), linear-gradient(90deg, {colors.border} 1px, transparent 1px)',
  backgroundSize: '34px 34px',
  smDown: { height: '440px' },
  '& .links': { position: 'absolute', inset: 0, width: '100%', height: '100%' },
  '& .links line': {
    stroke: 'border.strong',
    strokeWidth: '1.6',
    strokeDasharray: '5 7',
    vectorEffect: 'non-scaling-stroke',
    animation: 'dash 1.8s linear infinite',
  },
});
const node = css({
  position: 'absolute',
  transform: 'translate(-50%, -26px)',
  display: 'flex',
  flexDirection: 'column',
  alignItems: 'center',
  gap: '8px',
  '& .disc': {
    width: '52px',
    height: '52px',
    borderRadius: '50%',
    display: 'grid',
    placeItems: 'center',
    bg: 'bg.surface',
    boxShadow: '0 0 0 5px rgba(154,178,248,.25), {shadows.card}',
    color: 'fg',
    smDown: { width: '44px', height: '44px' },
  },
  '&[data-you] .disc': { outline: '2px dashed {colors.brand.lavender}', outlineOffset: '6px' },
  '& b': {
    fontFamily: 'mono',
    fontSize: '11.5px',
    fontWeight: '500',
    padding: '2px 9px',
    borderRadius: 'full',
    bg: 'bg.surface',
    boxShadow: 'card',
    whiteSpace: 'nowrap',
    smDown: { fontSize: '10px' },
  },
});
const servers = css({
  marginTop: '18px',
  display: 'grid',
  gridTemplateColumns: 'repeat(3, 1fr)',
  gap: '12px',
  lgDown: { gridTemplateColumns: 'repeat(2, 1fr)' },
  smDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const server = css({
  display: 'grid',
  gridTemplateColumns: '40px minmax(0, 1fr) auto',
  gap: '12px',
  alignItems: 'center',
  padding: '14px 16px',
  borderRadius: 'md',
  bg: 'bg.surface',
  boxShadow: 'card',
  '& .icon': {
    width: '40px',
    height: '40px',
    borderRadius: '13px',
    display: 'grid',
    placeItems: 'center',
    bg: 'bg.subtle',
  },
  '& b': {
    fontFamily: 'mono',
    fontSize: '13px',
    fontWeight: '500',
    overflow: 'hidden',
    textOverflow: 'ellipsis',
    whiteSpace: 'nowrap',
  },
  '& .n': {
    fontSize: '12px',
    fontWeight: '800',
    color: 'fg.muted',
    display: 'inline-flex',
    alignItems: 'center',
    gap: '5px',
    whiteSpace: 'nowrap',
  },
  '& .n i': { width: '7px', height: '7px', borderRadius: '50%', bg: 'green.400', display: 'block' },
});
const selfhost = css({
  marginTop: '18px',
  display: 'grid',
  gridTemplateColumns: 'auto minmax(0, 1fr)',
  gap: '28px',
  alignItems: 'center',
  padding: '24px 28px',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'card',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)', gap: '14px' },
  smDown: { padding: '20px' },
  '& h3': { fontSize: '19px', fontWeight: '800', whiteSpace: 'nowrap' },
  '& pre': {
    margin: 0,
    padding: '16px 18px 20px',
    borderRadius: 'md',
    bg: 'bg.code',
    color: '#dfe6f5',
    textStyle: 'mono',
    overflowX: 'auto',
  },
  '& .n': { color: 'status.warn' },
});
---

<Section id="federation" eyebrow="Decentralized" title="中央がない。" lead="人も、部屋も、作品も、それぞれの場所に。" center>
  <div class={layerGrid}>
    {
      layers.map((l) => (
        <article class={layer}>
          <span class:list={[layerIcon, tints[l.tint]]}>
            <Icon name={l.icon} size={26} />
          </span>
          <h3>{l.title}</h3>
          <p class={addr}>
            <b>{l.addr[0]}</b>
            {l.addr[1]}
          </p>
        </article>
      ))
    }
  </div>

  <div class={map} aria-label="サーバー同士が中心なくつながっている図" role="img">
    <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {
        exampleLinks.map(([a, b]) => (
          <line x1={exampleServers[a].x} y1={exampleServers[a].y} x2={exampleServers[b].x} y2={exampleServers[b].y} />
        ))
      }
    </svg>
    {
      exampleServers.map((s) => (
        <div class={node} style={`left:${s.x}%;top:${s.y}%`} data-you={'you' in s && s.you ? '' : undefined}>
          <span class="disc">
            <Icon name={s.icon} size={22} />
          </span>
          <b>{s.host}</b>
        </div>
      ))
    }
  </div>

  <ul class={servers} aria-label="サーバーの例">
    {
      exampleServers.map((s) => (
        <li class={server}>
          <span class="icon">
            <Icon name={s.icon} />
          </span>
          <b>{s.host}</b>
          <span class="n">
            <i />
            {s.users}
          </span>
        </li>
      ))
    }
  </ul>

  <div class={selfhost}>
    <h3>自分のサーバーを建てる</h3>
    <pre><code>helm install ubichill ubichill/ubichill -n ubichill \
  --create-namespace --set global.domain=<span class="n">your.server</span></code></pre>
  </div>
</Section>
