---
/**
 * 分散のセクション。人・部屋・作品の 3 層、夜空の上のサーバーの図、実在するサーバーの一覧、Helm、
 * フェディバース（Misskey・Mastodon）からのフォロー。
 * サーバーはいま公式（ubichill.com）だけ。ワールド数とプロフィールはビルド時に API から取る。
 */
import { css } from 'styled-system/css';
import { getFediProfile } from '../../data/fediverse';
import { servers, site } from '../../data/site';
import { getWorlds, worldShareUrl } from '../../data/worlds';
import Button from '../Button.astro';
import Icon, { type IconName } from '../Icon.astro';
import Section from '../Section.astro';

const { worlds } = await getWorlds();
const fedi = await getFediProfile();

const layers: { icon: IconName; title: string; addr: [string, string] }[] = [
  { icon: 'users', title: '人は、ホームサーバーに', addr: ['@yokan', '@yokan.example'] },
  { icon: 'home', title: '部屋は、部屋のサーバーに', addr: ['chill-room', '@ubichill.com'] },
  { icon: 'box', title: '作品は、作者の URL に', addr: ['mio.dev', '/mods/like/'] },
];

// 夜空の図。公式と「あなた」以外は名前のない灯り。x/y は % で、線はそこを結ぶ
const nodes = [
  { x: 24, y: 46, label: 'ubichill.com', sub: '公式', kind: 'official' },
  { x: 76, y: 58, label: 'あなたのサーバー', sub: 'helm install', kind: 'you' },
  { x: 50, y: 22, kind: 'other' },
  { x: 60, y: 82, kind: 'other' },
  { x: 90, y: 20, kind: 'other' },
  { x: 38, y: 84, kind: 'other' },
] as const;
const wires: [number, number][] = [
  [0, 1],
  [0, 2],
  [2, 4],
  [1, 4],
  [0, 3],
  [3, 1],
  [0, 5],
  [5, 3],
];
// 線の SVG は viewBox 0 0 100 40 を面いっぱいに伸ばす（y は % の 0.4 倍）
const wire = (a: (typeof nodes)[number], b: (typeof nodes)[number]) => {
  const mx = (a.x + b.x) / 2;
  const my = ((a.y + b.y) / 2 - 14) * 0.4;
  return `M${a.x} ${a.y * 0.4} Q ${mx} ${my} ${b.x} ${b.y * 0.4}`;
};

// 3 層は同じ形のカードを並べず、区切り線で分けた 1 枚のパネルにする
const layerGrid = css({
  marginTop: '48px',
  display: 'grid',
  gridTemplateColumns: 'repeat(3, minmax(0, 1fr))',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border}',
  textAlign: 'left',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const layer = css({
  display: 'grid',
  gridTemplateColumns: '20px minmax(0, 1fr)',
  gap: '8px 12px',
  alignItems: 'center',
  padding: '24px',
  '&:not(:first-child)': {
    borderLeft: '1px solid {colors.border}',
    mdDown: { borderLeft: 0, borderTop: '1px solid {colors.border}' },
  },
  '& h3': { fontSize: '16px', fontWeight: '700', lineHeight: '1.5' },
});
const layerIcon = css({ color: 'fg.muted', display: 'inline-flex' });
const addr = css({
  gridColumn: '2',
  justifySelf: 'start',
  fontFamily: 'mono',
  fontSize: '12px',
  padding: '4px 10px',
  borderRadius: 'sm',
  bg: 'bg.subtle',
  overflowWrap: 'anywhere',
  '& b': { color: 'highlight', fontWeight: '500' },
});
const sky = css({
  position: 'relative',
  marginTop: '16px',
  borderRadius: 'lg',
  overflow: 'hidden',
  isolation: 'isolate',
  bg: 'bg.inverse',
  color: 'fg.inverse',
  aspectRatio: '5 / 2',
  smDown: { aspectRatio: '4 / 3' },
  '& .wires': { position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block' },
  '& .stars': {
    position: 'absolute',
    inset: 0,
    zIndex: -1,
    backgroundImage:
      'radial-gradient(rgba(255,255,255,.75) 0.8px, transparent 1.2px), radial-gradient(rgba(255,255,255,.4) 0.6px, transparent 1px)',
    backgroundSize: '173px 131px, 97px 89px',
    backgroundPosition: '10px 20px, 50px 5px',
    maskImage: 'linear-gradient(180deg, #000, transparent 80%)',
  },
  '& .wire': {
    fill: 'none',
    stroke: 'rgba(255,255,255,.26)',
    strokeWidth: '1.4',
    strokeDasharray: '4 7',
    strokeLinecap: 'round',
    vectorEffect: 'non-scaling-stroke',
  },
});
const node = css({
  position: 'absolute',
  transform: 'translate(-50%, -28px)',
  display: 'grid',
  justifyItems: 'center',
  gap: '8px',
  textAlign: 'center',
  smDown: { transform: 'translate(-50%, -22px)' },
  '& .disc': {
    width: '56px',
    height: '56px',
    borderRadius: '50%',
    display: 'grid',
    placeItems: 'center',
    bg: 'rgba(255,255,255,.07)',
    boxShadow: 'inset 0 0 0 1px rgba(255,255,255,.18)',
    color: 'brand.periwinkle',
    smDown: { width: '44px', height: '44px' },
  },
  '& .disc i': { width: '14px', height: '14px', borderRadius: '50%', bg: 'currentColor', display: 'block' },
  '&[data-kind="official"] .disc': {
    color: 'brand.peach',
    boxShadow: 'inset 0 0 0 1px rgba(244,184,154,.5)',
  },
  '&[data-kind="you"] .disc': {
    color: 'brand.lavender',
    outline: '2px dashed rgba(206,176,250,.8)',
    outlineOffset: '5px',
  },
  '&[data-kind="other"]': { transform: 'translate(-50%, -50%)' },
  '&[data-kind="other"] .disc': { width: '14px', height: '14px', bg: 'rgba(255,255,255,.16)', boxShadow: 'none' },
  '&[data-kind="other"] .disc i': { display: 'none' },
  '& b': { fontSize: '14px', fontWeight: '700', whiteSpace: 'nowrap', smDown: { fontSize: '12px' } },
  '& small': { fontFamily: 'mono', fontSize: '11px', color: 'fg.inverseMuted', marginTop: '-4px' },
});
const serverList = css({
  marginTop: '16px',
  display: 'grid',
  gridTemplateColumns: '1fr 1fr',
  gap: '16px',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const serverCard = css({
  display: 'grid',
  gridTemplateColumns: '20px minmax(0, 1fr)',
  gap: '8px 12px',
  alignItems: 'center',
  padding: '24px',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border}',
  smDown: { padding: '20px' },
  '& .icon': { color: 'fg.muted', display: 'inline-flex' },
  '& h3': { fontSize: '18px', fontWeight: '500', fontFamily: 'mono' },
  '& .meta': {
    display: 'flex',
    flexWrap: 'wrap',
    alignItems: 'center',
    gridColumn: '2',
    gap: '8px 16px',
    color: 'fg.muted',
    fontSize: '13px',
  },
  '& .cta': { gridColumn: '2', marginTop: '12px' },
});
const selfhost = css({
  display: 'grid',
  gap: '12px',
  alignContent: 'center',
  padding: '24px',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border}',
  '& h3': { fontSize: '16px', fontWeight: '700' },
  '& pre': {
    margin: 0,
    padding: '16px 20px 20px',
    borderRadius: 'md',
    bg: 'bg.code',
    color: '#dfe6f5',
    textStyle: 'mono',
    overflowX: 'auto',
  },
  '& .n': { color: 'brand.peach' },
});
const fediCard = css({
  marginTop: '16px',
  display: 'grid',
  gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1.1fr)',
  gap: '40px',
  alignItems: 'center',
  padding: 'clamp(24px, 4vw, 44px)',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border}',
  textAlign: 'left',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)', gap: '28px' },
  '& h3': { fontSize: 'clamp(20px, 2.2vw, 24px)', fontWeight: '700', lineHeight: '1.5' },
  '& .lead': { marginTop: '12px', color: 'fg.muted', textStyle: 'body' },
  '& .lead code': { fontFamily: 'mono', fontSize: '13px', color: 'fg' },
  '& .soon': { marginTop: '16px', color: 'fg.subtle', textStyle: 'small' },
});
// フェディバースのクライアントで検索したときの見え方（特定のクライアントに似せない、素の形）
const fediMock = css({
  display: 'grid',
  gap: '12px',
  padding: '16px',
  borderRadius: 'md',
  bg: 'bg.subtle',
  '& .search': {
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
    padding: '12px 16px',
    borderRadius: 'sm',
    bg: 'bg.surface',
    fontFamily: 'mono',
    fontSize: '13px',
    color: 'fg.muted',
    overflowWrap: 'anywhere',
  },
  '& .profile': {
    display: 'grid',
    gap: '12px',
    padding: '20px',
    borderRadius: 'sm',
    bg: 'bg.surface',
  },
  // 狭いとフォローボタンが次の行に回る
  '& .who': { display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: '12px' },
  '& .id': { flex: '1 1 160px', minWidth: 0, display: 'grid' },
  '& .avatar': {
    flex: 'none',
    width: '48px',
    height: '48px',
    borderRadius: '14px',
    objectFit: 'cover',
    bg: 'bg.subtle',
  },
  '& .name': { fontWeight: '700', fontSize: '15px', lineHeight: '1.4' },
  '& .handle': { fontFamily: 'mono', fontSize: '12px', color: 'fg.muted', overflowWrap: 'anywhere' },
  '& .follow': {
    marginLeft: 'auto',
    padding: '7px 16px',
    borderRadius: 'full',
    bg: 'accent',
    color: 'accent.fg',
    fontSize: '13px',
    fontWeight: '700',
  },
  '& .bio': { fontSize: '14px', whiteSpace: 'pre-line' },
  '& .worlds': { display: 'grid', gap: '6px' },
  '& .worlds small': { color: 'fg.subtle', fontSize: '12px', fontWeight: '700' },
  '& .worlds a': {
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'space-between',
    gap: '10px',
    padding: '8px 12px',
    borderRadius: 'sm',
    boxShadow: 'inset 0 0 0 1px {colors.border}',
    fontSize: '14px',
    fontWeight: '600',
    transition: 'background {durations.fast}',
    _hover: { bg: 'bg.subtle' },
  },
});
---

<Section id="federation" title="中央がない" lead="人も、部屋も、作品も、それぞれの場所に" center>
  <div class={layerGrid}>
    {
      layers.map((l) => (
        <article class={layer}>
          <span class={layerIcon}>
            <Icon name={l.icon} size={20} />
          </span>
          <h3>{l.title}</h3>
          <p class={addr}>
            <b>{l.addr[0]}</b>
            {l.addr[1]}
          </p>
        </article>
      ))
    }
  </div>

  <div class={sky} role="img" aria-label="公式サーバーとあなたのサーバー、ほかのサーバーが中心なくつながっている図">
    <div class="stars" aria-hidden="true"></div>
    <svg class="wires" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
      {wires.map(([a, b]) => <path class="wire" d={wire(nodes[a], nodes[b])} />)}
    </svg>
    {
      nodes.map((n) => (
        <div class={node} data-kind={n.kind} style={`left:${n.x}%;top:${n.y}%`}>
          <span class="disc">
            <i />
          </span>
          {'label' in n && (
            <>
              <b>{n.label}</b>
              <small>{n.sub}</small>
            </>
          )}
        </div>
      ))
    }
  </div>

  <div class={serverList}>
    {
      servers.map((s) => (
        <article class={serverCard}>
          <span class="icon">
            <Icon name="globe" size={20} />
          </span>
          <h3>{s.host}</h3>
          <p class="meta">
            <span>
              {s.note}
            </span>
            <span>{worlds.length} ワールド</span>
          </p>
          <div class="cta">
            <Button href={site.app} size="sm" icon="arrow-ur">
              アプリを開く
            </Button>
          </div>
        </article>
      ))
    }
    <article class={selfhost}>
      <h3>自分のサーバーを建てる</h3>
      <pre><code>helm install ubichill ubichill/ubichill -n ubichill \
  --create-namespace --set global.domain=<span class="n">your.server</span></code></pre>
    </article>
  </div>

  <div class={fediCard}>
    <div>
      <h3>Misskey や Mastodon から、<br />フォローできる</h3>
      <p class="lead">
        <code>@ID@ubichill.com</code> で検索すると、自己紹介と作ったワールドが出てくる。
      </p>
      <p class="soon">ubichill からフェディバースへの投稿も、これから。</p>
    </div>
    <div class={fediMock} aria-label={`フェディバースで @${fedi.handle} を検索したときの例`}>
      <div class="search">
        <Icon name="globe" size={16} />@{fedi.handle}
      </div>
      <div class="profile">
        <div class="who">
          {
            fedi.icon ? (
              <img class="avatar" src={fedi.icon} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer" />
            ) : (
              <span class="avatar" />
            )
          }
          <div class="id">
            <a class="name" href={fedi.url}>{fedi.name}</a>
            <span class="handle">@{fedi.handle}</span>
          </div>
          <span class="follow" aria-hidden="true">フォロー</span>
        </div>
        {fedi.summary && <p class="bio">{fedi.summary}</p>}
        {
          fedi.worlds.length > 0 && (
            <div class="worlds">
              <small>作ったワールド</small>
              {fedi.worlds.slice(0, 3).map((w) => (
                <a href={worldShareUrl(w)}>
                  {w.displayName}
                  <Icon name="arrow-ur" size={14} />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</Section>
