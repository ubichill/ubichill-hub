---
/**
 * ヒーロー。夕暮れの空の色の面に、見出し・一言・お知らせ・ボタンと、実画面を入れた暗い窓。
 * 動きはゆっくり（空の色が流れる・窓が浮く）。prefers-reduced-motion では止まる。
 * 画面は `site.heroVideo` を入れると <video> に切り替わる。
 */
import { Image } from 'astro:assets';
import { css } from 'styled-system/css';
import worldShot from '../../assets/world-together.png';
import { announcement, site } from '../../data/site';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Logo3D from '../Logo3D.astro';
import Window from '../Window.astro';

const wrap = css({ position: 'relative', padding: '12px clamp(10px, 3vw, 40px) 0' });
const card = css({
  position: 'relative',
  overflow: 'hidden',
  maxWidth: 'wide',
  marginInline: 'auto',
  borderRadius: 'xl',
  backgroundImage: '{gradients.dusk}',
  padding: 'clamp(64px, 8vw, 112px) 0 clamp(64px, 8vw, 104px)',
  isolation: 'isolate',
  smDown: { borderRadius: '32px' },
});
// 空の光。ぼかした円をゆっくり流す
const glow = css({
  position: 'absolute',
  zIndex: -1,
  borderRadius: '50%',
  // 円は radial-gradient で端が消えるので filter: blur は使わない（モバイルで重い）
  willChange: 'transform',
  _motionSafe: { animation: 'drift 26s ease-in-out infinite' },
});
const sun = css({
  width: '560px',
  height: '560px',
  right: '-120px',
  bottom: '-260px',
  background: 'radial-gradient(circle, rgba(244, 184, 154, 0.85), rgba(244, 184, 154, 0) 70%)',
  _dark: { opacity: 0.45 },
  smDown: { width: '360px', height: '360px', right: '-140px', bottom: '-160px' },
});
const haze = css({
  width: '720px',
  height: '520px',
  left: '-220px',
  top: '-220px',
  animationDelay: '-9s',
  background: 'radial-gradient(circle, rgba(189, 225, 251, 0.9), rgba(189, 225, 251, 0) 70%)',
  _dark: { opacity: 0.3 },
});
const violet = css({
  width: '520px',
  height: '520px',
  right: '18%',
  top: '-300px',
  animationDelay: '-17s',
  background: 'radial-gradient(circle, rgba(206, 176, 250, 0.8), rgba(206, 176, 250, 0) 70%)',
  _dark: { opacity: 0.35 },
});
// 夜だけ星が出る
const stars = css({
  display: 'none',
  position: 'absolute',
  inset: 0,
  zIndex: -1,
  backgroundImage:
    'radial-gradient(rgba(255,255,255,.9) 0.8px, transparent 1.2px), radial-gradient(rgba(255,255,255,.6) 0.7px, transparent 1.1px)',
  backgroundSize: '140px 120px, 90px 80px',
  backgroundPosition: '0 0, 40px 30px',
  maskImage: 'linear-gradient(180deg, #000 0%, transparent 70%)',
  _motionSafe: { animation: 'breathe 7s ease-in-out infinite' },
  _dark: { display: 'block' },
});
const grain = css({
  position: 'absolute',
  inset: 0,
  zIndex: -1,
  pointerEvents: 'none',
  backgroundImage: 'var(--noise)',
  opacity: 0.055,
  _dark: { opacity: 0.08 },
});
const inner = css({
  width: 'min({sizes.container}, 100% - clamp(40px, 8vw, 80px))',
  marginInline: 'auto',
  display: 'grid',
  gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1.05fr)',
  gap: '48px',
  alignItems: 'center',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)', gap: '36px' },
});
const h1 = css({ textStyle: 'display' });
const lead = css({ marginTop: '22px', maxWidth: '30em', textStyle: 'lead', color: 'fg.muted' });
const pill = css({
  marginTop: '26px',
  display: 'inline-flex',
  alignItems: 'center',
  gap: '10px',
  maxWidth: '100%',
  padding: '5px 16px 5px 5px',
  borderRadius: 'full',
  bg: 'bg.glass',
  backdropFilter: 'blur(10px)',
  boxShadow: 'card',
  fontSize: '14px',
  fontWeight: '500',
  transition: 'transform {durations.normal} ease',
  _hover: { transform: 'translateY(-1px)' },
  '& .icon': {
    width: '32px',
    height: '32px',
    borderRadius: '50%',
    display: 'grid',
    placeItems: 'center',
    backgroundImage: '{gradients.brandSoft}',
    color: 'navy.900',
    flex: 'none',
  },
  '& .t': { overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' },
  '& b': { fontFamily: 'heading', fontWeight: '800' },
});
const cta = css({ marginTop: '28px', display: 'flex', flexWrap: 'wrap', gap: '14px' });
const visual = css({
  position: 'relative',
  perspective: '1800px',
  padding: '12px 0 72px 44px',
  mdDown: { padding: '0 0 56px 28px' },
});
const shot = css({
  transform: 'rotateY(-9deg) rotateX(3deg)',
  transformOrigin: 'left center',
  _motionSafe: { animation: 'float 9s ease-in-out infinite' },
  smDown: { transform: 'rotateY(-6deg) rotateX(2deg)' },
  '& img, & video': { aspectRatio: '16 / 9', objectFit: 'cover' },
});
// 窓の左下の角にかかる程度。画面の中身は隠さない
const logo = css({
  position: 'absolute',
  left: '-12%',
  bottom: 0,
  width: 'clamp(140px, 15vw, 200px)',
  zIndex: 2,
  smDown: { width: '34%', left: '-6%' },
});
---

<div class={wrap}>
  <div class={card}>
    <div class:list={[glow, haze]} aria-hidden="true"></div>
    <div class:list={[glow, violet]} aria-hidden="true"></div>
    <div class:list={[glow, sun]} aria-hidden="true"></div>
    <div class={stars} aria-hidden="true"></div>
    <div class={grain} aria-hidden="true"></div>

    <div class={inner}>
      <div>
        <h1 class={h1} id="hero-title">ゆるく集まる、<br />じぶんの部屋。</h1>
        <p class={lead}>描いたり、観たり、いっしょに過ごす 2D メタバース。ワールドも mod も、自分で作って、自分で持てる。</p>
        <a class={pill} href={announcement.href}>
          <span class="icon"><Icon name="megaphone" size={16} /></span>
          <span class="t"><b>{announcement.label}</b> {announcement.text}</span>
          <Icon name="arrow" size={16} />
        </a>
        <div class={cta}>
          <Button href={site.app} icon="arrow-ur">アプリを開く</Button>
          <Button href="#about" variant="secondary">詳しく知る</Button>
        </div>
      </div>

      <div class={visual} data-logo3d-host>
        <Window class={shot} url="ubichill.com/@yokan/chill-room">
          {
            site.heroVideo ? (
              <video src={site.heroVideo} poster={worldShot.src} muted loop playsinline autoplay aria-label="Ubichill のワールドの様子" />
            ) : (
              <Image src={worldShot} alt="Ubichill のワールド。夜の部屋で 4 人のカーソルが集まり、ペンで波やハートを描いている" widths={[640, 960, 1280]} sizes="(max-width: 768px) 100vw, 640px" loading="eager" fetchpriority="high" />
            )
          }
        </Window>
        <div class={logo}><Logo3D depth={30} /></div>
      </div>
    </div>
  </div>
</div>
