---
import { Image } from 'astro:assets';
import { css } from 'styled-system/css';
import editorShot from '../../assets/app-editor.png';
import { announcement, site } from '../../data/site';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Logo3D from '../Logo3D.astro';

const wrap = css({ position: 'relative', padding: '12px clamp(10px, 3vw, 40px) 0' });
const card = css({
  position: 'relative',
  overflow: 'hidden',
  maxWidth: 'wide',
  marginInline: 'auto',
  borderRadius: 'xl',
  bg: 'bg.hero',
  padding: 'clamp(56px, 7vw, 96px) 0 clamp(150px, 14vw, 190px)',
  isolation: 'isolate',
  smDown: { borderRadius: '28px' },
});
const blob = css({ position: 'absolute', borderRadius: '50%', zIndex: -1 });
const blobPeri = css({
  width: '760px',
  height: '760px',
  right: '-170px',
  top: '-260px',
  background: 'radial-gradient(circle at 35% 40%, #b9c9fb, {colors.brand.periwinkle} 70%)',
  _dark: { opacity: 0.45 },
  smDown: { width: '480px', height: '480px', right: '-220px', top: 'auto', bottom: '120px' },
});
const blobLav = css({
  width: '420px',
  height: '420px',
  right: '260px',
  bottom: '-250px',
  background: 'radial-gradient(circle at 50% 30%, #e2d0fd, {colors.brand.lavender} 75%)',
  opacity: 0.9,
  _dark: { opacity: 0.35 },
  smDown: { right: '-120px' },
});
const blobSky = css({
  width: '520px',
  height: '520px',
  left: '-200px',
  bottom: '-330px',
  background: 'radial-gradient(circle at 60% 30%, #def0fe, {colors.brand.sky} 70%)',
  _dark: { opacity: 0.35 },
});
const dots = css({
  position: 'absolute',
  inset: 0,
  zIndex: -1,
  opacity: 0.5,
  backgroundImage: 'radial-gradient({colors.border.strong} 1px, transparent 1.2px)',
  backgroundSize: '26px 26px',
  maskImage: 'linear-gradient(100deg, #000 0%, transparent 55%)',
});
const inner = css({
  width: 'min({sizes.container}, 100% - clamp(40px, 8vw, 80px))',
  marginInline: 'auto',
  display: 'grid',
  gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1fr)',
  gap: '40px',
  alignItems: 'center',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const h1 = css({
  textStyle: 'display',
  '& .grad': { backgroundImage: '{gradients.brand}', backgroundClip: 'text', color: 'transparent' },
});
const lead = css({ marginTop: '26px', maxWidth: '34em', textStyle: 'lead' });
const pill = css({
  marginTop: '26px',
  display: 'inline-flex',
  alignItems: 'center',
  gap: '10px',
  maxWidth: '100%',
  padding: '5px 16px 5px 5px',
  borderRadius: 'full',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 2px {colors.brand.periwinkle}',
  fontSize: '14px',
  fontWeight: '500',
  '& .icon': {
    width: '32px',
    height: '32px',
    borderRadius: '50%',
    display: 'grid',
    placeItems: 'center',
    backgroundImage: '{gradients.brandSoft}',
    color: 'navy.900',
    flex: 'none',
  },
  '& .t': { overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' },
  '& b': { fontFamily: 'heading', fontWeight: '800' },
});
const cta = css({ marginTop: '28px', display: 'flex', flexWrap: 'wrap', gap: '14px' });
const visual = css({
  position: 'relative',
  minHeight: '460px',
  perspective: '1600px',
  mdDown: { minHeight: 0, aspectRatio: '4 / 3', marginTop: '10px' },
  smDown: { aspectRatio: '1 / 1' },
});
const shot = css({
  position: 'absolute',
  right: '-6%',
  top: '6%',
  width: '112%',
  borderRadius: '14px',
  overflow: 'hidden',
  bg: 'bg.surface',
  boxShadow: 'float',
  transform: 'rotateY(-16deg) rotateX(6deg) rotateZ(1deg)',
  transformOrigin: 'left center',
  mdDown: { right: 0, width: '96%' },
  smDown: { top: '4%', width: '100%', transform: 'rotateY(-10deg) rotateX(4deg)' },
  '& .bar': {
    height: '30px',
    display: 'flex',
    alignItems: 'center',
    gap: '6px',
    padding: '0 12px',
    bg: 'bg.subtle',
    borderBottom: '1px solid {colors.border}',
  },
  '& .bar i': { width: '9px', height: '9px', borderRadius: '50%', bg: 'border.strong', display: 'block' },
  '& .url': { marginLeft: '10px', fontSize: '10.5px', color: 'fg.muted', fontFamily: 'mono' },
  '& img, & video': {
    width: '100%',
    height: 'auto',
    aspectRatio: '16 / 9',
    objectFit: 'cover',
    objectPosition: 'left top',
  },
});
const logo = css({
  position: 'absolute',
  left: '-4%',
  bottom: '-4%',
  width: 'clamp(200px, 21vw, 300px)',
  zIndex: 2,
  smDown: { width: '46%', left: '-2%', bottom: '2%' },
});
---

<div class={wrap}>
  <div class={card}>
    <div class:list={[blob, blobPeri]} aria-hidden="true"></div>
    <div class:list={[blob, blobLav]} aria-hidden="true"></div>
    <div class:list={[blob, blobSky]} aria-hidden="true"></div>
    <div class={dots} aria-hidden="true"></div>

    <div class={inner}>
      <div>
        <h1 class={h1} id="hero-title">Build. Own.<br />Connect.<br />with <span class="grad">Ubichill</span>.</h1>
        <p class={lead}>ワールドも mod も、自分で作って、自分で持てる。<br />中央のない 2D メタバース。</p>
        <a class={pill} href={announcement.href}>
          <span class="icon"><Icon name="megaphone" size={16} /></span>
          <span class="t"><b>{announcement.label}</b> {announcement.text}</span>
          <Icon name="arrow" size={16} />
        </a>
        <div class={cta}>
          <Button href={site.app} icon="arrow-ur">アプリを開く</Button>
          <Button href="#about" variant="secondary">詳しく知る</Button>
        </div>
      </div>

      <div class={visual} data-logo3d-host>
        <figure class={shot}>
          <div class="bar"><i></i><i></i><i></i><span class="url">ubichill.com</span></div>
          {
            site.heroVideo ? (
              <video src={site.heroVideo} poster={editorShot.src} muted loop playsinline autoplay aria-label="Ubichill のワールドの様子" />
            ) : (
              <Image src={editorShot} alt="Ubichill のワールドエディタ。動画プレイヤーやペンをワールドに配置している画面" widths={[640, 960, 1280]} sizes="(max-width: 768px) 100vw, 640px" loading="eager" fetchpriority="high" />
            )
          }
        </figure>
        <Logo3D class={logo} depth={30} />
      </div>
    </div>
  </div>
</div>
