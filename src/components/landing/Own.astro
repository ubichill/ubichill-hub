---
/** 「作ったものは、自分の場所に」。署名済みワールドの例 */
import { css } from 'styled-system/css';
import Icon, { type IconName } from '../Icon.astro';

const points: { icon: IconName; title: string; text: string }[] = [
  { icon: 'link', title: 'ワールド＝URL', text: '開けば、だれでも入れる。' },
  { icon: 'key', title: '鍵は手元に', text: 'サーバーは秘密鍵を預からない。' },
  { icon: 'badge-check', title: '作者署名', text: '改ざんとなりすましを見分ける。' },
  { icon: 'git', title: 'ただのファイル', text: 'Git で管理して、持ち出せる。' },
];

const section = css({ paddingTop: 'clamp(88px, 11vw, 150px)' });
const inner = css({
  width: 'min({sizes.container}, 100% - clamp(40px, 8vw, 80px))',
  marginInline: 'auto',
  display: 'grid',
  gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1.05fr)',
  gap: '56px',
  alignItems: 'center',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)', gap: '40px' },
});
const h2 = css({ textStyle: 'h2' });
const lead = css({ marginTop: '16px', color: 'fg.muted', textStyle: 'lead' });
const list = css({ marginTop: '32px', display: 'grid', gap: '20px' });
const point = css({
  display: 'grid',
  gridTemplateColumns: '40px 1fr',
  gap: '16px',
  alignItems: 'center',
  '& h3': { fontSize: '16px', fontWeight: '700', lineHeight: '1.5' },
  '& p': { textStyle: 'small', color: 'fg.muted' },
});
// アイコンは文字と同じ色。色のついたタイルには入れない
const iconBox = css({
  width: '40px',
  height: '40px',
  borderRadius: '12px',
  display: 'grid',
  placeItems: 'center',
  color: 'fg.muted',
  boxShadow: 'inset 0 0 0 1px {colors.border.strong}',
});
const art = css({
  position: 'relative',
  padding: '32px 0 32px 32px',
  mdDown: { padding: '24px 0' },
});
const card = css({
  position: 'relative',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'float',
  overflow: 'hidden',
  '& .head': {
    display: 'flex',
    alignItems: 'center',
    gap: '10px',
    padding: '16px 24px',
    borderBottom: '1px solid {colors.border}',
    fontFamily: 'mono',
    fontSize: '13px',
  },
  '& dl': {
    margin: 0,
    padding: '4px 24px',
    display: 'grid',
    gridTemplateColumns: 'auto minmax(0, 1fr)',
    columnGap: '20px',
  },
  '& dt, & dd': { padding: '12px 0', borderBottom: '1px dashed {colors.border}' },
  '& dt': { fontSize: '13px', color: 'fg.muted', whiteSpace: 'nowrap' },
  '& dd': {
    margin: 0,
    display: 'flex',
    alignItems: 'center',
    gap: '8px',
    flexWrap: 'wrap',
    minWidth: 0,
    fontFamily: 'mono',
    fontSize: '13px',
    overflowWrap: 'anywhere',
  },
  '& dl > :nth-last-child(-n+2)': { borderBottom: 0 },
  '& .ok': { color: 'status.ok', display: 'inline-flex' },
  '& .hosts': { padding: '16px 24px 20px', bg: 'bg.subtle', display: 'flex', flexWrap: 'wrap', gap: '8px' },
});
const badge = css({
  marginLeft: 'auto',
  display: 'inline-flex',
  alignItems: 'center',
  gap: '4px',
  fontSize: '12px',
  fontWeight: '700',
  padding: '4px 10px',
  borderRadius: 'full',
  bg: 'status.okBg',
  color: 'status.ok',
  whiteSpace: 'nowrap',
  fontFamily: 'body',
});
const host = css({
  display: 'inline-flex',
  alignItems: 'center',
  padding: '6px 12px',
  borderRadius: 'full',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border.strong}',
  fontFamily: 'mono',
  fontSize: '12px',
  '&[data-on]': { bg: 'accent', color: 'accent.fg', boxShadow: 'none' },
});
---

<section class={section} id="own" aria-labelledby="own-title">
  <div class={inner}>
    <div>
      <h2 class={h2} id="own-title">作ったものは、<br />自分の場所に</h2>
      <p class={lead}>ワールドも mod も URL。どこに置いても、署名で本物とわかる。</p>
      <ul class={list}>
        {
          points.map((p) => (
            <li class={point}>
              <span class={iconBox}>
                <Icon name={p.icon} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class={art}>
      <article class={card} aria-label="署名されたワールドの例">
        <div class="head">
          <Icon name="file-code" />chill-room.yaml
          <span class={badge}><Icon name="badge-check" size={14} />作者署名あり</span>
        </div>
        <dl>
          <dt>作者</dt><dd>@yokan@yokan.example</dd>
          <dt>置き場所</dt><dd>yokan.github.io/worlds/chill-room.yaml</dd>
          <dt>署名</dt><dd>ed25519<span class="ok"><Icon name="check" size={14} /></span></dd>
          <dt>内容</dt><dd>sha256-9f2c…e41a<span class="ok"><Icon name="check" size={14} /></span></dd>
        </dl>
        <div class="hosts">
          <span class={host}>Ubichill</span>
          <span class={host} data-on>GitHub Pages</span>
          <span class={host}>自分のサーバー</span>
          <span class={host}>S3</span>
        </div>
      </article>
    </div>
  </div>
</section>
