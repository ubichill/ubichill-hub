---
import { css } from 'styled-system/css';
import { site } from '../../data/site';
import Icon, { type IconName } from '../Icon.astro';
import Section from '../Section.astro';

const items: { icon: IconName; title: string; code: string; href: string }[] = [
  { icon: 'login', title: '入ってみる', code: 'ubichill.com', href: site.app },
  { icon: 'layout', title: 'エディタで作る', code: 'ブラウザだけ', href: '/docs/create/editor/' },
  { icon: 'terminal', title: 'コードで作る', code: 'npx ubichill dev', href: '/docs/mods/' },
  { icon: 'upload', title: '公開する', code: 'ubichill publish', href: '/docs/publish/' },
  { icon: 'server', title: 'サーバーを建てる', code: 'helm install', href: '/docs/servers/self-hosting/' },
];

// 同じ形のカードを並べず、区切り線で分けた 1 枚のパネルにする（狭いと縦の一覧）
const grid = css({
  marginTop: '40px',
  display: 'grid',
  gridTemplateColumns: 'repeat(5, minmax(0, 1fr))',
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'inset 0 0 0 1px {colors.border}',
  overflow: 'hidden',
  lgDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const item = css({
  display: 'grid',
  gap: '8px',
  alignContent: 'start',
  padding: '24px',
  textAlign: 'left',
  transition: 'background {durations.fast} ease',
  _hover: { bg: 'bg.subtle' },
  '&:not(:first-child)': { borderLeft: '1px solid {colors.border}' },
  lgDown: {
    gridTemplateColumns: '20px minmax(0, 1fr) auto',
    alignItems: 'center',
    gap: '12px',
    padding: '16px 20px',
    '&:not(:first-child)': { borderLeft: 0, borderTop: '1px solid {colors.border}' },
  },
  '& .icon': { color: 'fg.muted', display: 'inline-flex' },
  '& h3': { marginTop: '8px', fontSize: '16px', fontWeight: '700', lineHeight: '1.5', lgDown: { marginTop: 0 } },
  '& code': {
    overflow: 'hidden',
    textOverflow: 'ellipsis',
    whiteSpace: 'nowrap',
    fontFamily: 'mono',
    fontSize: '12px',
    color: 'fg.muted',
  },
});
---

<Section id="start" title="はじめる" center>
  <div class={grid}>
    {
      items.map((it) => (
        <a class={item} href={it.href} rel={it.href.startsWith('http') ? 'noopener' : undefined}>
          <span class="icon">
            <Icon name={it.icon} size={20} />
          </span>
          <h3>{it.title}</h3>
          <code>{it.code}</code>
        </a>
      ))
    }
  </div>
</Section>
