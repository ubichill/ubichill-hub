---
import { Image } from 'astro:assets';
import { css } from 'styled-system/css';
import editorShot from '../../assets/app-editor.png';
import Icon from '../Icon.astro';
import Section from '../Section.astro';

const grid = css({
  marginTop: '48px',
  display: 'grid',
  gridTemplateColumns: '1fr 1fr',
  gap: '18px',
  mdDown: { gridTemplateColumns: 'minmax(0, 1fr)' },
});
const way = css({
  borderRadius: 'lg',
  bg: 'bg.surface',
  boxShadow: 'card',
  overflow: 'hidden',
  display: 'flex',
  flexDirection: 'column',
  '& .body': { padding: '28px 32px 22px', smDown: { padding: '22px 22px 18px' } },
  '& .tag': {
    display: 'inline-flex',
    alignItems: 'center',
    gap: '8px',
    textStyle: 'eyebrow',
    fontSize: '12px',
    letterSpacing: '0.14em',
    color: 'fg.subtle',
  },
  '& h3': { marginTop: '4px', fontSize: '22px', fontWeight: '800' },
  '& .art': { flex: 1, minHeight: '280px', display: 'flex' },
});
const editorArt = css({
  padding: '24px 0 0 32px',
  background: 'linear-gradient(160deg, {colors.tint.sky}, {colors.tint.periwinkle})',
  smDown: { padding: '18px 0 0 18px' },
  '& img': {
    width: '100%',
    height: '100%',
    minHeight: '256px',
    borderRadius: '12px 0 0 0',
    boxShadow: '-6px -6px 30px rgba(27,42,68,.12)',
    objectFit: 'cover',
    objectPosition: 'left top',
  },
});
const codeArt = css({
  flexDirection: 'column',
  justifyContent: 'center',
  gap: '12px',
  padding: '24px 28px',
  bg: 'bg.code',
  color: '#dfe6f5',
  smDown: { padding: '18px' },
  '& .msg': {
    alignSelf: 'flex-end',
    maxWidth: '92%',
    padding: '9px 14px',
    borderRadius: '16px 16px 4px 16px',
    bg: 'brand.periwinkle',
    color: 'navy.900',
    fontSize: '13px',
    fontWeight: '700',
  },
  '& pre': {
    padding: '14px 16px',
    borderRadius: '12px',
    bg: 'rgba(255,255,255,.05)',
    textStyle: 'mono',
    fontSize: '12px',
    overflowX: 'auto',
  },
  '& .term': {
    textStyle: 'mono',
    fontSize: '12px',
    padding: '10px 14px',
    borderRadius: '12px',
    bg: 'rgba(255,255,255,.05)',
    whiteSpace: 'nowrap',
    overflowX: 'auto',
  },
  '& .k': { color: 'brand.lavender' },
  '& .s': { color: '#a6e3b4' },
  '& .c': { color: '#7d8aa6' },
});
---

<Section id="create" eyebrow="Create" title="エディタでも、コードでも。" center>
  <div class={grid}>
    <article class={way}>
      <div class="body">
        <span class="tag"><Icon name="layout" size={16} />ブラウザ</span>
        <h3>置いて、つなげるだけ。</h3>
      </div>
      <div class:list={['art', editorArt]}>
        <Image src={editorShot} alt="ブラウザのワールドエディタ" widths={[560, 1120]} sizes="(max-width: 768px) 100vw, 560px" />
      </div>
    </article>
    <article class={way}>
      <div class="body">
        <span class="tag"><Icon name="sparkles" size={16} />コード</span>
        <h3>AI に頼んでもいい。</h3>
      </div>
      <div class:list={['art', codeArt]}>
        <div class="msg">ペンと動画がある作業部屋を作って</div>
        <pre><code><span class="c"># worlds/chill-room.yaml</span>
<span class="k">kind</span>: World
<span class="k">metadata</span>: {'{'} <span class="k">name</span>: <span class="s">chill-room</span> {'}'}
<span class="k">spec</span>:
  <span class="k">dependencies</span>:
    - <span class="k">name</span>: <span class="s">pen</span>
    - <span class="k">name</span>: <span class="s">video-player</span></code></pre>
        <div class="term"><span class="c">$</span> npx ubichill dev&nbsp;&nbsp;<span class="s">➜</span> localhost:3333</div>
      </div>
    </article>
  </div>
</Section>
