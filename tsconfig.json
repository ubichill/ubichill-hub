{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "styled-system/*": ["./styled-system/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "styled-system/**/*",
    "scripts/**/*",
    "panda.config.ts",
    "astro.config.mjs"
  ],
  "exclude": ["dist", "node_modules", "mockups"]
}
