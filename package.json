{
  "name": "ubichill-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "hub.ubichill.com — Ubichill のホーム・ドキュメント",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/subset-fonts.mjs",
    "preview": "astro preview",
    "prepare": "panda codegen",
    "sync-docs": "node scripts/sync-docs.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@pandacss/dev": "^2.5.0",
    "astro": "^7.4.7",
    "mermaid": "^12.3.0",
    "sharp": "^0.35.5",
    "starlight-image-zoom": "^0.16.2",
    "starlight-theme-rapide": "^0.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ]
  }
}
